'use strict';

let myName = "Anna";
const year = 2009;

// Функція, яка друкує привітання та має один аргумент: name
function greet(name) {                      // Оголошуємо функцію з параметром name
  console.log(`Привіт, ${name}!`);          // Друкуємо привітання, підставляючи значення name у шаблонний рядок
}

// Виклик функції
greet(myName);            // Передаємо у функцію значення змінної name